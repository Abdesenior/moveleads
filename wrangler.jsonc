// Cloudflare Workers config for the MoveLeads frontend (static SPA).
// worker/index.js runs first: canonical 301s, then static assets, then the
// SPA shell (200 for app routes, 404 for unknown paths).
// Build first: `cd client && npm ci && npm run build`, then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moveleads",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "main": "worker/index.js",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // Keeps the Render API awake (see scheduled() in worker/index.js).
  "triggers": { "crons": ["*/14 * * * *"] },
  "routes": [
    { "pattern": "moveleads.cloud", "custom_domain": true },
    { "pattern": "www.moveleads.cloud", "custom_domain": true }
  ]
}
