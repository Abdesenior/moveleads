# ── API ───────────────────────────────────────────────────────────────────────
# Backend API base URL — must NOT have a trailing slash or /api suffix
VITE_API_URL=https://api.moveleads.cloud

# ── Google Maps ───────────────────────────────────────────────────────────────
# Create/find in Google Cloud Console → APIs & Services → Credentials
# Enable: Maps JavaScript API, Places API
# Restrict key to: https://moveleads.cloud/* and https://www.moveleads.cloud/*
VITE_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Stripe (publishable key — public, safe to bake into the bundle) ───────────
# Required for embedded checkout in the partner activation flow.
# Set this in Vercel → Environment Variables (Production + Preview).
# Use pk_live_... in production, pk_test_... for test/preview.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX

# ── Meta Pixel (Facebook tracking pixel — public, baked into the bundle) ──────
# Public-by-design: same value lives in the backend's META_PIXEL_ID.
# Browser fires `PageView` on every app boot and `Lead` after a successful
# /get-quote submission, with the SAME event_id the server uses for CAPI
# dedup. Leave unset to disable the browser Pixel entirely (server CAPI
# still fires if the backend has its own env configured).
# Find in: Meta Events Manager → Data Sources → your pixel → ID
VITE_META_PIXEL_ID=000000000000000

# ── Mover Meta Pixel (separate pixel for the mover acquisition funnel) ────────
# Public-by-design; same value lives in the backend's META_MOVER_PIXEL_ID.
# Isolated from the homeowner pixel via trackSingle; fires PageView (entry
# pages), Lead (activation-offer), CompleteRegistration, and Purchase.
# Find in: Meta Events Manager → Data Sources → mover pixel → ID
VITE_META_MOVER_PIXEL_ID=1721087862641992

# ── Feature flags ─────────────────────────────────────────────────────────────
# Discounted Leads (Deal Room) — server enforces availability via the
# ENABLE_DEAL_ROOM env. This client flag controls whether the sidebar nav
# item appears at all. Set to 'true' to match a production server that has
# ENABLE_DEAL_ROOM=true; otherwise the item is hidden so movers don't click
# into the "currently unavailable" page.
VITE_ENABLE_DEAL_ROOM=false
