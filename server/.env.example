# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (LIVE cluster)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/moveleads?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use a DIFFERENT secret in production than in development.
JWT_SECRET=replace_with_a_64_byte_random_hex_string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=https://moveleads.cloud,https://www.moveleads.cloud

# ── Frontend URL ───────────────────────────────────────────────────────────────
# Used in Stripe Checkout success_url / cancel_url redirects (no trailing slash)
CLIENT_URL=https://moveleads.cloud

# ── Stripe (LIVE keys) ────────────────────────────────────────────────────────
# IMPORTANT: Use LIVE keys (sk_live_... / whsec_...) in production.
#            Never commit sk_test_... or sk_live_... keys to source control.
# Find in: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Find in: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (LIVE credentials) ─────────────────────────────────────────────────
# IMPORTANT: Use production Account SID + Auth Token (not test credentials).
#            Test credentials use magic numbers that never send real SMS.
# Find in: Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your purchased Twilio phone number in E.164 format (e.g. +18005551234)
TWILIO_PHONE_NUMBER=+15005550006

# ── Resend (transactional email) ──────────────────────────────────────────────
# All emails (verification, dispute approvals) are sent via Resend.
# Domain moveleads.cloud must be verified in Resend Dashboard → Domains.
# Emails are sent from: no-reply@moveleads.cloud
# Find API key at: resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Mover-coverage Phase 3 — strict interstate matching ──────────────────────
# Controls whether the dashboard "Matches your setup" badge, SMS lead alerts,
# and email lead alerts use the STRICT origin-AND-destination matcher (true)
# or fall back to the legacy origin-OR-destination matcher (false / unset).
#
# When STRICT mode is on, a mover only matches a lead if BOTH:
#   - lead.originState is in mover.pickupStates (or origin ZIP in their pickup CoverageArea)
#   AND
#   - lead.destinationState is in mover.deliveryStates (or in their delivery CoverageArea)
#     OR mover.deliversNationwide is true
#
# Shadow-comparison log lines fire on every match decision regardless of the
# flag's value: `[MatchShadow] source=… lead=… mover=… legacy=… strict=…`
# so the operator can diff candidate counts on real traffic BEFORE flipping.
#
# Default OFF. Flip to true only after the shadow logs confirm the delta is
# sensible (≤60% drop healthy; ≥90% drop = config bug — pause and investigate).
STRICT_INTERSTATE_MATCHING=false

# ── Meta Pixel + Conversions API ──────────────────────────────────────────────
# Browser Pixel JS and server-side CAPI fire the same Lead event with a shared
# event_id for deduplication. Backend foundation is in place as of Commit 1
# (capture + persist only); the CAPI POST itself ships in a later commit.
#
# META_PIXEL_ID is public-by-design (it appears in the client bundle as
# VITE_META_PIXEL_ID). Keep the same value in both vars.
# META_CAPI_ACCESS_TOKEN is the secret — server-only, NEVER expose to the
# client bundle. Generate at Events Manager → Settings → Conversions API.
# META_CAPI_TEST_EVENT_CODE routes events to Events Manager → Test Events
# during QA. Unset (or empty) in production so events flow to live reporting.
META_PIXEL_ID=000000000000000
META_CAPI_ACCESS_TOKEN=replace_with_capi_token_backend_only
META_CAPI_TEST_EVENT_CODE=
